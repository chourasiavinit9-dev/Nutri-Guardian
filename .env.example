# Nutri-Guardian Pro Environment Variables Example
# Copy this file to .env.local and populate with your own API keys

# Gemini API Key (for Clinical Symptoms Scribe & Diagnostic Reasoning)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Grok (xAI) or Groq Vision API Key (for Camera Food Label & Nutrition OCR)
# Supports xAI (grok-...) or GroqCloud (gsk_...)
VITE_GROK_API_KEY=your_grok_or_groq_api_key_here
GROK_API_KEY=your_grok_or_groq_api_key_here
